# PostgreSQL Database URL (Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-a-strong-secret-here"
NEXTAUTH_URL="https://mekanikparcadeposu.com"

# Google Analytics 4 - Olcum Kimligi (Measurement ID), orn: G-XXXXXXXXXX
# Bos birakilirsa GA yuklenmez. Sadece production'da calisir.
NEXT_PUBLIC_GA_ID=""

# Kurumsal basvuru ozelligi (varsayilan: kapali)
# Yalnizca acikca "true" degeri ozelligi acar. Baska/bos/gecersiz deger = kapali.
# Bu deger SUNUCU tarafinda okunur; istemci tarafindan etkinlestirilemez.
ENABLE_CORPORATE_APPLICATION="false"
